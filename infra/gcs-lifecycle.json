{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 2,
        "matchesPrefix": ["source/", "tts/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 14,
        "matchesPrefix": ["output/"]
      }
    },
    {
      "action": { "type": "AbortIncompleteMultipartUpload" },
      "condition": { "age": 1 }
    }
  ]
}
