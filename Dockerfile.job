FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.build.json vitest.config.ts ./
COPY src ./src
COPY scripts ./scripts
COPY remotion ./remotion
RUN pnpm build
RUN pnpm prune --prod

FROM node:22-bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    curl \
    fontconfig \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    python3 \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
  && chmod a+rx /usr/local/bin/yt-dlp

ENV NODE_ENV=production
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/remotion ./remotion
COPY base_prompt ./base_prompt
COPY db ./db

# Install custom TTF fonts into Linux OS system font store
RUN mkdir -p /usr/share/fonts/truetype/custom \
  && cp remotion/public/fonts/*.ttf /usr/share/fonts/truetype/custom/ \
  && fc-cache -f -v

USER node
ENTRYPOINT ["node", "dist/src/job-entry.js"]
CMD ["scan"]
